# ===========================================================
# Edge Functions · secretos
# Se cargan en Supabase, no en el repo:
#   supabase secrets set --project-ref <ref> NOMBRE=valor
# Para probar en local: copiar a supabase/functions/.env (ignorado) y
#   supabase functions serve --env-file supabase/functions/.env
# ===========================================================

# Los pone Supabase solo en cada función desplegada:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# lumbre-ai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# activar-invitacion (a dónde vuelve el enlace; por defecto la de producción)
ANIMA_APP_URL=http://localhost:5180/app/?activar=1

# meta-leads, meta-ads, calendario, push: sus llaves NO son variables de
# entorno. Viven en Vault y se leen con meta_secret_get() (migración 0134),
# incluida la llave del cron (meta_leads_cron_key).
